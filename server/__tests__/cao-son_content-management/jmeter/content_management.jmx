      <!-- ╔══════════════════════════════════════════════════════════════════════╗ -->
      <!-- ║ THREAD GROUP 2: LOAD TEST – 50 users, 10 loops                      ║ -->
      <!-- ║ Mục đích: Mô phỏng tải bình thường (10% users online đồng thời)     ║ -->
      <!-- ║ Tổng requests: 50 users × 10 loops × 12 samplers = 6,000 requests   ║ -->
      <!-- ║ Ramp-up 10s: Mỗi 0.2s thêm 1 user mới (50/10 = 5 users/giây)       ║ -->
      <!-- ╚══════════════════════════════════════════════════════════════════════╝ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Load Test - 50 Users" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <!-- loops=10: Mỗi user lặp lại 10 lần toàn bộ samplers -->
          <stringProp name="LoopController.loops">10</stringProp>
        </elementProp>
        <!-- num_threads=50: 50 virtual users chạy song song -->
        <stringProp name="ThreadGroup.num_threads">50</stringProp>
        <!-- ramp_time=10: Mất 10 giây để khởi động hết 50 threads -->
        <stringProp name="ThreadGroup.ramp_time">10</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
