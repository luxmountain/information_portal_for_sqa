          </hashTree>
        </hashTree>

        <!-- CRUD dưới 50 users: Đây là nơi phát hiện DB write contention
             50 threads × 10 loops = 500 lần INSERT/UPDATE/DELETE qua connection pool = 10
             → Tranh chấp connection → một số request chậm > 2s → Duration Assert FAIL -->

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-L10 - POST /api/news Create (TC101)" enabled="true">
          <stringProp name="HTTPSampler.path">/api/news</stringProp>
