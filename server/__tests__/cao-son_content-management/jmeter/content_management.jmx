      <!-- ╔══════════════════════════════════════════════════════════════════════╗ -->
      <!-- ║ THREAD GROUP 3: STRESS TEST – 200 users, 5 loops                    ║ -->
      <!-- ║ Mục đích: Đẩy hệ thống đến giới hạn, tìm điểm sập                  ║ -->
      <!-- ║ Tổng requests: 200 users × 5 loops × 11 samplers ≈ 9,200 requests   ║ -->
      <!-- ║ Ramp-up 30s: 200/30 = 6.7 users/giây (chậm hơn Load → ít burst)    ║ -->
      <!-- ║ Duration Assert nới lên 5s (chấp nhận chậm hơn dưới stress)         ║ -->
      <!-- ╚══════════════════════════════════════════════════════════════════════╝ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Stress Test - 200 Users" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <!-- loops=5: Ít hơn Load (10) để tránh test quá lâu -->
          <stringProp name="LoopController.loops">5</stringProp>
        </elementProp>
        <!-- num_threads=200: 200 virtual users đồng thời -->
        <stringProp name="ThreadGroup.num_threads">200</stringProp>
        <!-- ramp_time=30: 30 giây để khởi động hết 200 threads
             Dài hơn Load (10s) → requests phân bổ đều hơn → ít burst hơn
             Đây là lý do Stress 0% error mà Load 0.22% error -->
        <stringProp name="ThreadGroup.ramp_time">30</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>

