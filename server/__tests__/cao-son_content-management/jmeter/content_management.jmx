<?xml version="1.0" encoding="UTF-8"?>
<!-- ╔══════════════════════════════════════════════════════════════════════════╗ -->
<!-- ║ JMETER TEST PLAN – Content Management Performance Test                   ║ -->
<!-- ║ Tác giả: Cao Sơn | Server: localhost:4000 (Express + MySQL)              ║ -->
<!-- ║ File .jmx là định dạng XML mô tả toàn bộ kịch bản test của JMeter        ║ -->
<!-- ╚══════════════════════════════════════════════════════════════════════════╝ -->

<!-- jmeterTestPlan: Thẻ gốc của file .jmx
     - version="1.2": Phiên bản định dạng file
     - properties="5.0": Phiên bản properties
     - jmeter="5.6.3": Phiên bản JMeter tạo file này -->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">

  <!-- hashTree: Thẻ container chứa các phần tử con trong JMeter.
       Mỗi element trong JMeter đều được theo sau bởi 1 hashTree chứa các child elements.
       hashTree rỗng (<hashTree/>) = element đó không có con. -->
  <hashTree>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- TEST PLAN: Node gốc chứa toàn bộ test plan                            -->
    <!-- guiclass: Class hiển thị trên GUI JMeter                               -->
    <!-- testclass: Class thực thi logic                                        -->
    <!-- testname: Tên hiển thị trong JMeter GUI                                -->
    <!-- enabled="true": Bật/tắt element này                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Content Management Performance Test - Cao Son" enabled="true">
      <!-- functional_mode=false: Không lưu response data cho mỗi request (tiết kiệm RAM) -->
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <!-- serialize_threadgroups=true: Các Thread Group chạy TUẦN TỰ (Smoke → Load → Stress)
           Nếu false thì tất cả Thread Group chạy song song cùng lúc -->
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <!-- comments: Ghi chú mô tả test plan -->
      <stringProp name="TestPlan.comments">JMeter Performance Test cho Content Management API. Server: localhost:4000</stringProp>
      <!-- user_define_classpath: Đường dẫn tới JAR bổ sung (không dùng) -->
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
      <!-- user_defined_variables: Biến toàn cục định nghĩa ở Test Plan level (không dùng) -->
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- ═══════════════════════════════════════════════════════════════════════ -->
      <!-- HTTP REQUEST DEFAULTS: Cấu hình mặc định cho TẤT CẢ HTTP Request     -->
      <!-- Đặt ở Test Plan level → áp dụng cho mọi sampler trong toàn bộ plan    -->
      <!-- Tránh phải lặp lại host/port ở mỗi request                            -->
      <!-- ═══════════════════════════════════════════════════════════════════════ -->
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true">
        <!-- domain: Địa chỉ server (IP của WSL host, dùng khi chạy JMeter từ Windows) -->
        <stringProp name="HTTPSampler.domain">172.17.176.1</stringProp>
        <!-- port: Cổng server Express đang lắng nghe -->
        <stringProp name="HTTPSampler.port">4000</stringProp>
        <!-- protocol: Giao thức HTTP (không dùng HTTPS vì là local dev) -->
        <stringProp name="HTTPSampler.protocol">http</stringProp>
        <!-- path: Đường dẫn mặc định (rỗng, mỗi sampler tự định nghĩa) -->
        <stringProp name="HTTPSampler.path"></stringProp>
        <!-- concurrentPool: Số kết nối đồng thời tối đa trong pool HTTP client -->
        <stringProp name="HTTPSampler.concurrentPool">6</stringProp>
        <!-- connect_timeout: Thời gian tối đa chờ kết nối TCP (5 giây) -->
        <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
        <!-- response_timeout: Thời gian tối đa chờ server phản hồi (10 giây) -->
        <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
      </ConfigTestElement>
      <!-- hashTree rỗng = HTTP Defaults không có child elements -->
      <hashTree/>

      <!-- ═══════════════════════════════════════════════════════════════════════ -->
      <!-- HTTP HEADER MANAGER: Định nghĩa headers gửi kèm MỌI request          -->
      <!-- Đặt ở Test Plan level → áp dụng cho tất cả samplers (Scoping Rule)    -->
      <!-- ═══════════════════════════════════════════════════════════════════════ -->
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
        <!-- collectionProp: Danh sách các header -->
        <collectionProp name="HeaderManager.headers">
          <!-- Header 1: Báo server rằng body request là JSON -->
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <!-- Header 2: Báo server rằng client muốn nhận JSON response -->
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Accept</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>


      <!-- ╔══════════════════════════════════════════════════════════════════════╗ -->
      <!-- ║ THREAD GROUP 1: SMOKE TEST – 1 user, 1 loop                         ║ -->
      <!-- ║ Mục đích: Kiểm tra tất cả API hoạt động đúng với 1 user duy nhất    ║ -->
      <!-- ║ Nếu Smoke fail → server có vấn đề cơ bản, không cần test tiếp       ║ -->
      <!-- ╚══════════════════════════════════════════════════════════════════════╝ -->

      <!-- ThreadGroup: Mô phỏng 1 nhóm virtual users
           - Mỗi thread = 1 user ảo, chạy song song và độc lập
           - on_sample_error="continue": Nếu 1 request lỗi, vẫn tiếp tục chạy các request sau -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Smoke Test - 1 User" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <!-- LoopController: Điều khiển số lần lặp
             - continue_forever=false: Không lặp vô hạn
             - loops=1: Mỗi thread chạy toàn bộ samplers 1 lần -->
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <!-- num_threads=1: Chỉ 1 virtual user (smoke test) -->
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <!-- ramp_time=1: Thời gian khởi động tất cả threads (1 giây, vì chỉ có 1 thread) -->
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <!-- scheduler=false: Không dùng scheduler (chạy ngay lập tức) -->
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <!-- same_user_on_next_iteration=true: Giữ nguyên context (cookies, biến) giữa các iteration -->
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <!-- hashTree chứa tất cả samplers bên trong Thread Group này -->
      <hashTree>

        <!-- ─────────────────────────────────────────────────────────────────── -->
        <!-- SAMPLER 1: GET /api/health – Kiểm tra server có sống không          -->
        <!-- HTTPSamplerProxy: Gửi 1 HTTP request tới server                     -->
        <!-- ─────────────────────────────────────────────────────────────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S01 - GET /api/health" enabled="true">
          <!-- path: Đường dẫn API (kết hợp với domain/port từ HTTP Defaults) -->
          <stringProp name="HTTPSampler.path">/api/health</stringProp>
          <!-- method: Phương thức HTTP (GET = đọc dữ liệu) -->
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <!-- follow_redirects: Tự động theo redirect 3xx -->
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <!-- use_keepalive: Giữ kết nối TCP mở (tái sử dụng cho request tiếp) -->
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <!-- hashTree chứa các Assertion (kiểm tra kết quả) của sampler này -->
        <hashTree>
          <!-- ResponseAssertion: Kiểm tra response code = 200
               - test_field=Assertion.response_code: Kiểm tra mã HTTP status
               - test_type=2: Kiểu so sánh "Contains" (chứa chuỗi "200")
               - assume_success=false: Không giả định thành công trước khi kiểm tra -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true">
            <collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <!-- DurationAssertion: Kiểm tra thời gian phản hồi ≤ 2000ms
               Nếu server trả về chậm hơn 2s → FAIL (dù HTTP status đúng) -->
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- ─────────────────────────────────────────────────────────────────── -->
        <!-- SAMPLER 2: GET /api/home – Trang chủ (6 query DB đồng thời)         -->
        <!-- Endpoint nặng nhất: lấy stats, banners, events, news, admissions... -->
        <!-- ─────────────────────────────────────────────────────────────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S02 - GET /api/home" enabled="true">
          <stringProp name="HTTPSampler.path">/api/home</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true">
            <collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- SAMPLER 3: GET /api/news – Danh sách tin tức (liên quan Unit Test TC105) -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S03 - GET /api/news (TC105)" enabled="true">
          <stringProp name="HTTPSampler.path">/api/news</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true">
            <collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- SAMPLER 4: GET /api/events – Danh sách sự kiện (TC107) -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S04 - GET /api/events (TC107)" enabled="true">
          <stringProp name="HTTPSampler.path">/api/events</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true">
            <collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- SAMPLER 5: GET /api/recruitment – Danh sách tuyển dụng (TC111) -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S05 - GET /api/recruitment (TC111)" enabled="true">
          <stringProp name="HTTPSampler.path">/api/recruitment</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true">
            <collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- SAMPLER 6: GET /api/departments – Danh sách bộ môn kèm JOIN lecturers (TC119) -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S06 - GET /api/departments (TC119)" enabled="true">
          <stringProp name="HTTPSampler.path">/api/departments</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true">
            <collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- SAMPLER 7: GET /api/majors – Danh sách ngành học (TC131) -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S07 - GET /api/majors (TC131)" enabled="true">
          <stringProp name="HTTPSampler.path">/api/majors</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true">
            <collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- SAMPLER 8: GET /api/banners – Danh sách banner trang chủ -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S08 - GET /api/banners" enabled="true">
          <stringProp name="HTTPSampler.path">/api/banners</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true">
            <collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- SAMPLER 9: GET /api/enterprises – Danh sách doanh nghiệp -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S09 - GET /api/enterprises" enabled="true">
          <stringProp name="HTTPSampler.path">/api/enterprises</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true">
            <collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- ─────────────────────────────────────────────────────────────────── -->
        <!-- SAMPLER 10: GET /api/news?page=1&limit=10 – Test phân trang (TC137) -->
        <!-- Khác với sampler 3: có query parameters page và limit               -->
        <!-- ─────────────────────────────────────────────────────────────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S10 - GET /api/news Pagination (TC137)" enabled="true">
          <stringProp name="HTTPSampler.path">/api/news</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <!-- HTTPsampler.Arguments: Danh sách query parameters (?key=value)
               JMeter tự nối vào URL: /api/news?page=1&limit=10 -->
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
            <collectionProp name="Arguments.arguments">
              <!-- Parameter: page=1 (trang đầu tiên) -->
              <elementProp name="page" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">page</stringProp>
                <stringProp name="Argument.value">1</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <!-- Parameter: limit=10 (10 bản ghi mỗi trang) -->
              <elementProp name="limit" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">limit</stringProp>
                <stringProp name="Argument.value">10</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true">
            <collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>


        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- ONCE ONLY CONTROLLER: Login chỉ chạy 1 lần ở iteration đầu tiên   -->
        <!-- Theo JMeter docs: "The login request will be executed only the     -->
        <!-- first time through. Subsequent iterations will skip it."           -->
        <!-- Lý do: Login gọi bcrypt.compare() tốn ~75-139ms, không cần lặp    -->
        <!-- Token JWT có hạn 8h → đủ dùng cho toàn bộ test                    -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Login Once" enabled="true"/>
        <hashTree>
          <!-- SAMPLER 11: POST /api/auth/login – Đăng nhập lấy JWT token -->
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S11 - POST /api/auth/login" enabled="true">
            <stringProp name="HTTPSampler.path">/api/auth/login</stringProp>
            <!-- method=POST: Gửi dữ liệu lên server (tạo session/token) -->
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <!-- postBodyRaw=true: Gửi body dạng raw JSON (không phải form-data) -->
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <!-- Arguments: Nội dung body request (JSON login credentials) -->
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <!-- Body JSON: email + password của admin account -->
                  <stringProp name="Argument.value">{"email":"admin@fit.edu.vn","password":"admin123"}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true">
              <collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">2</intProp>
            </ResponseAssertion>
            <hashTree/>
            <!-- ─────────────────────────────────────────────────────────────── -->
            <!-- JSON POST PROCESSOR: Trích xuất giá trị từ JSON response        -->
            <!-- Chạy SAU khi sampler nhận response (Post-Processor)              -->
            <!-- Dùng JSONPath expression để lấy token từ response body           -->
            <!-- Response: {"success":true, "token":"eyJhbG..."} → lấy $.token   -->
            <!-- Lưu vào biến thread-local "auth_token" để dùng ở samplers sau   -->
            <!-- ─────────────────────────────────────────────────────────────── -->
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract Token" enabled="true">
              <!-- referenceNames: Tên biến lưu kết quả (dùng ${auth_token} ở sau) -->
              <stringProp name="JSONPostProcessor.referenceNames">auth_token</stringProp>
              <!-- jsonPathExprs: JSONPath expression – $.token = lấy field "token" ở root -->
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.token</stringProp>
              <!-- match_numbers=1: Lấy kết quả đầu tiên tìm được -->
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <!-- defaultValues: Giá trị mặc định nếu không tìm thấy (debug) -->
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- SAMPLER 12: POST /api/news – Tạo tin tức mới (TC101)               -->
        <!-- Cần Authorization header với JWT token từ login ở trên              -->
        <!-- Dùng hàm JMeter: ${__threadNum} = số thứ tự thread hiện tại        -->
        <!--                   ${__iterationNum} = số thứ tự iteration hiện tại  -->
        <!-- → Tạo title unique cho mỗi request, tránh trùng lặp                -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S12 - POST /api/news Create (TC101)" enabled="true">
          <stringProp name="HTTPSampler.path">/api/news</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <!-- Body: JSON tạo news với title chứa threadNum và iterationNum -->
                <stringProp name="Argument.value">{"title":"JMeter Perf ${__threadNum}-${__iterationNum}","summary":"Perf test","content":"Content by JMeter"}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <!-- HeaderManager ở SAMPLER level: CHỈ áp dụng cho sampler này
               Thêm Authorization header với token đã extract từ login
               Scoping Rule: Header ở child level override/bổ sung cho parent -->
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Auth Header" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <!-- ${auth_token}: Biến thread-local chứa JWT token từ login -->
                <stringProp name="Header.value">Bearer ${auth_token}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <!-- Assert 201: Create thành công trả về HTTP 201 Created -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 201" enabled="true">
            <collectionProp name="Asserion.test_strings"><stringProp name="49587">201</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
          <!-- Extract ID của news vừa tạo để dùng cho Update và Delete
               Response: {"id":157, "title":"..."} → lấy $.id = 157
               Lưu vào biến ${created_news_id} -->
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract News ID" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">created_news_id</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.id</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">0</stringProp>
          </JSONPostProcessor>
          <hashTree/>
        </hashTree>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- SAMPLER 13: PUT /api/news/:id – Cập nhật tin tức (TC103)            -->
        <!-- Path dùng biến ${created_news_id} từ Create ở trên                  -->
        <!-- VD: /api/news/157 (ID 157 được extract từ response Create)          -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TJ-S13 - PUT /api/news Update (TC103)" enabled="true">
          <!-- Path chứa biến: /api/news/${created_news_id} → /api/news/157 -->
          <stringProp name="HTTPSampler.path">/api/news/${created_news_id}</stringProp>
          <!-- method=PUT: Cập nhật toàn bộ/một phần resource -->
          <stringProp name="HTTPSampler.method">PUT</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"title":"Updated by JMeter ${__threadNum}"}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Auth Header" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${auth_token}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200" enabled="true">
            <collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- SAMPLER 14: DELETE /api/news/:id – Xóa tin tức (TC104)              -->
        <!-- Xóa bài vừa tạo → tự cleanup, không để rác trong DB                -->
